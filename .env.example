# ── Required ────────────────────────────────────────────────────────────
CHICKADEE_TELEGRAM_BOT_TOKEN=

# ── Telegram access control (* = open, or comma-separated chat IDs) ────
CHICKADEE_ALLOWED_CHAT_IDS=*

# ── Telegram webhook (optional, for webhook mode) ──────────────────────
TELEGRAM_WEBHOOK_SECRET=

# ── LM Studio (laptop, primary when available) ────────────────────────
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=gemma-4-e4b-it
LM_STUDIO_API_KEY=

# ── Cloud provider API keys (sourced from ~/.zshrc) ────────────────────
# In the container these come from the host shell via docker-compose.
# Model lists (OLLAMA_MODELS, OPENROUTER_FREE_MODELS, etc.) are hardcoded in
# docker-compose.yml and are NOT set here.
OLLAMA_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ── Transcription (YouTube audio → text via OpenRouter) ────────────────
TRANSCRIPTION_MODEL=xiaomi/mimo-v2.5

# ── Vault ──────────────────────────────────────────────────────────────
VAULT_FORMAT=obsidian              # or logseq
# The vault itself is always ./vault inside the project. No VAULT_PATH needed.
